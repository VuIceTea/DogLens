<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFeaturedTopic"
    android:layout_width="170dp"
    android:layout_height="100dp"
    android:layout_marginEnd="12dp"
    android:background="#ffffff"
    android:clipToOutline="true"
    android:elevation="1dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/imgFeatureTopic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh chủ đề"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_topic_bottom_overlay" />

    <TextView
        android:id="@+id/txtFeaturedTopicTitle"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="14dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Chó thân thiện với trẻ em"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnFeaturedTopicNext"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_topic_next_button"
        android:gravity="center"
        android:text="›"
        android:textColor="#1585FD"
        android:textSize="30sp"
        android:includeFontPadding="false"/>
</FrameLayout>