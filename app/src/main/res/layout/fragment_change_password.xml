<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F8FF">

    <ImageView android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="top|end" android:layout_marginTop="58dp" android:layout_marginEnd="-12dp" android:alpha="0.16" android:src="@drawable/deco_paw" />
    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginBottom="18dp" android:alpha="0.13" android:rotation="-18" android:src="@drawable/deco_paw" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_light" android:contentDescription="Quay lại" android:padding="11dp" android:src="@drawable/ic_arrow_back" app:tint="#071B4D" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đổi mật khẩu" android:textColor="#071B4D" android:textSize="27sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bảo vệ tài khoản của bạn" android:textColor="#71809B" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:background="@drawable/bg_notification_icon_blue">
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:src="@drawable/ic_lock" app:tint="#168BFF" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Tạo mật khẩu mạnh để giữ tài khoản DogLens luôn an toàn" android:textColor="#52627C" android:textSize="16sp" />

            <LinearLayout android:id="@+id/socialAccountNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_change_password_notice" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tài khoản liên kết" android:textColor="#071B4D" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Bạn đăng nhập bằng Google hoặc Facebook nên không thể đổi mật khẩu tại DogLens. Hãy quản lý mật khẩu tại nhà cung cấp đăng nhập của bạn." android:textColor="#52627C" android:textSize="16sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/passwordForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_profile_menu" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutCurrentPassword" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mật khẩu hiện tại" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:endIconMode="password_toggle" app:startIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCurrentPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutNewPassword" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Mật khẩu mới" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:endIconMode="password_toggle" app:startIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutConfirmPassword" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Xác nhận mật khẩu mới" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:endIconMode="password_toggle" app:startIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Mật khẩu cần ít nhất 8 ký tự, có chữ viết hoa và chữ số." android:textColor="#71809B" android:textSize="15sp" />

                <FrameLayout android:id="@+id/btnUpdatePassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:background="@drawable/bg_save_profile_button" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/tvUpdatePassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Cập nhật mật khẩu" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
                    <ProgressBar android:id="@+id/progressUpdatePassword" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:indeterminateTint="#FFFFFF" android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
