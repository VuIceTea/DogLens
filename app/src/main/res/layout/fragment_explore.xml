<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:ignore=".ui.explore.ExploreFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F9FC"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        android:paddingVertical="12dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/exploreHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunitosans_extrabold"
                    android:text="Khám phá"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_notification" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Tìm hiểu thế giới của những chú chó"
                android:textColor="#71809B" />

        </LinearLayout>

        <!-- Search -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/bg_explore_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imaSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_nav_search" />

            <EditText
                android:id="@+id/txtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tìm giống chó, ví dụ: Golden Retriever..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#71809B"
                android:textColorHint="#71809B"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Banner -->
        <LinearLayout
            android:id="@+id/exploreBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgExploreBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:src="@drawable/explore_300_breeds" />
        </LinearLayout>


        <!-- Categories heading -->
        <include
            android:id="@+id/headerCategories"
            layout="@layout/item_explore_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryExplore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:itemCount="5"
            tools:listitem="@layout/item_explore_category" />

        <!-- Featured topics section -->
        <include
            android:id="@+id/headerFeaturedTopics"
            layout="@layout/item_explore_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeaturedTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:itemCount="3"
            tools:listitem="@layout/item_featured_topic" />

        <!-- Dog use cases section -->
        <include
            android:id="@+id/headerDogUseCases"
            layout="@layout/item_explore_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDogUseCases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:itemCount="5"
            tools:listitem="@layout/item_dog_use_case" />

    </LinearLayout>
</ScrollView>
