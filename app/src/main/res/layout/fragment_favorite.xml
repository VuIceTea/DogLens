<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F9FC"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunitosans_extrabold"
                    android:text="Yêu thích"
                    android:textColor="#102344"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />


                <TextView
                    android:id="@+id/txtFavoriteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_favorite_count"
                    android:drawableStart="@drawable/ic_heart_favorite"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="12 giống chó"
                    android:textColor="#F5142F"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Những giống chó bạn đã lưu"
                android:textColor="#71809B" />
        </LinearLayout>

        <!-- Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/bg_explore_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_nav_search" />

            <EditText
                android:id="@+id/txtSeach"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tìm trong danh sách yêu thích..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#71809B"
                android:textColorHint="#71809B"
                android:textSize="14sp" />
        </LinearLayout>



        <!-- Filter + Sort: hiển thị trên cùng một hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1585FD"
                app:cornerRadius="24dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterSmall"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="Chó nhỏ"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#71809B"
                app:backgroundTint="#E5EBF4"
                app:cornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D7E0ED"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterMedium"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="Chó trung"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#71809B"
                app:backgroundTint="#E5EBF4"
                app:cornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D7E0ED"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterLarge"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="Chó lớn"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#71809B"
                app:backgroundTint="#E5EBF4"
                app:cornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D7E0ED"/>

            <Spinner
                android:id="@+id/spinnerFavoriteSort"
                android:layout_width="112dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_favorite_sort"
                android:spinnerMode="dropdown"
                android:dropDownVerticalOffset="4dp"
                android:dropDownWidth="112dp"
                android:padding="0dp" />

        </LinearLayout>


        <TextView
            android:id="@+id/txtFavoriteEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="Không tìm thấy giống chó yêu thích"
            android:textColor="#7A8BA5"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavoriteDogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>