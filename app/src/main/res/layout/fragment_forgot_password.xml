<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F8FF">

    <ImageView android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="top|end" android:layout_marginTop="54dp" android:layout_marginEnd="-14dp" android:alpha="0.16" android:src="@drawable/deco_paw" />
    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginBottom="18dp" android:alpha="0.14" android:rotation="-18" android:src="@drawable/deco_paw" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_light" android:contentDescription="Quay lại" android:padding="11dp" android:src="@drawable/ic_arrow_back" app:tint="#071B4D" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quên mật khẩu" android:textColor="#071B4D" android:textSize="27sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khôi phục quyền truy cập tài khoản" android:textColor="#71809B" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/resetFormContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="126dp" android:layout_height="126dp" android:layout_marginTop="18dp" android:background="@drawable/bg_notification_icon_blue">
                    <ImageView android:layout_width="82dp" android:layout_height="82dp" android:layout_gravity="center" android:src="@drawable/ic_email_key" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Đừng lo, chúng tôi sẽ giúp bạn!" android:textColor="#071B4D" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:lineSpacingExtra="3dp" android:text="Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu." android:textColor="#52627C" android:textSize="16sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_profile_menu" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Email của bạn" android:textColor="#071B4D" android:textSize="17sp" android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutResetEmail" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:boxStrokeColor="#168BFF" app:boxStrokeWidth="2dp" app:boxStrokeWidthFocused="2dp" app:startIconDrawable="@drawable/ic_email" app:startIconTint="#168BFF">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etResetEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="example@email.com" android:inputType="textEmailAddress" android:minHeight="58dp" android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_settings_info" android:drawablePadding="7dp" android:text="Liên kết đặt lại mật khẩu sẽ được gửi đến email này." android:textColor="#71809B" android:textSize="14sp" />

                    <FrameLayout android:id="@+id/btnSendReset" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_save_profile_button" android:clickable="true" android:focusable="true">
                        <LinearLayout android:id="@+id/tvSendReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_send_mail" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Gửi liên kết đặt lại mật khẩu" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                        <ProgressBar android:id="@+id/progressSendReset" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:indeterminateTint="#FFFFFF" android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/btnBackToLogin" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã nhớ mật khẩu?" android:textColor="#071B4D" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Quay lại đăng nhập" android:textColor="#168BFF" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/resetSuccessContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="72dp" android:background="@drawable/bg_profile_menu" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
                <FrameLayout android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/bg_reset_success_icon"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:src="@drawable/ic_check_success" /></FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Kiểm tra email của bạn" android:textColor="#071B4D" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Chúng tôi đã gửi liên kết đặt lại mật khẩu đến" android:textColor="#52627C" android:textSize="15sp" />
                <TextView android:id="@+id/tvSentEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#168BFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnResend" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:gravity="center" android:text="Chưa nhận được? Gửi lại" android:textColor="#168BFF" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnBackToLoginSuccess" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_save_profile_button" android:gravity="center" android:text="Quay lại đăng nhập" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/imgForgotDog"
        android:layout_width="154dp"
        android:layout_height="188dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitEnd"
        android:src="@drawable/dog_forgot_password" />
</FrameLayout>
