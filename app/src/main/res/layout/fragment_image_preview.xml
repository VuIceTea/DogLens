<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Quay lại"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Điều chỉnh ảnh"
        android:textColor="#10245E"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <FrameLayout
        android:id="@+id/cropViewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_preview_image"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintBottom_toTopOf="@id/toolRow"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6EDF6"
            android:contentDescription="Ảnh đang điều chỉnh"
            android:scaleType="fitCenter" />

        <com.example.doglens.ui.camera.CropGridView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolRow"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/toolFree"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_tool_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:id="@+id/iconFree" android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/ic_crop_free" app:tint="#FFFFFF" />
            <TextView android:id="@+id/labelFree" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tự do" android:textColor="#168FF2" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolSquare"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_tool_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:id="@+id/iconSquare" android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/ic_crop_square" app:tint="#10245E" />
            <TextView android:id="@+id/labelSquare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Vuông" android:textColor="#7885A6" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolLandscape"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_tool_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:id="@+id/iconLandscape" android:layout_width="29dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/ic_crop_landscape" app:tint="#10245E" />
            <TextView android:id="@+id/labelLandscape" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="4:3" android:textColor="#7885A6" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolPortrait"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_tool_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:id="@+id/iconPortrait" android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/ic_crop_portrait" app:tint="#10245E" />
            <TextView android:id="@+id/labelPortrait" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="3:4" android:textColor="#7885A6" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolRotate"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_tool_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_rotate_clockwise" app:tint="#10245E" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Xoay" android:textColor="#7885A6" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_preview_continue"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiếp tục" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="12dp" android:contentDescription="@null" android:src="@drawable/ic_arrow_forward" app:tint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
