<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="-12dp"
        android:alpha="0.14"
        android:src="@drawable/deco_paw" />

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="18dp"
        android:alpha="0.12"
        android:rotation="-18"
        android:src="@drawable/deco_paw" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="Quay lại"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#102344" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông báo"
                android:textColor="#071B4D"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cập nhật mới nhất dành cho bạn"
                android:textColor="#71809B"
                android:layout_marginTop="1dp"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnReadAll"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:drawableStart="@drawable/ic_mark_all_read"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Đọc tất cả"
            android:textColor="#168BFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_suggested_filter_selected"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Tất cả"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterRecognition"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_suggested_filter_default"
            android:gravity="center"
            android:minWidth="98dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Nhận diện"
            android:textColor="#52627C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/filterUpdate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_suggested_filter_default"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Cập nhật"
            android:textColor="#52627C"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Chưa có thông báo"
            android:textColor="#71809B"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
