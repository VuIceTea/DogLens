<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnPremiumBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/premium_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#10245E" />

        <TextView
            style="@style/PremiumHeading"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="60dp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/premium_title"
            android:textSize="21sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="150dp"
                android:background="@drawable/bg_premium_card"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_premium_diamond" />
                    <TextView
                        style="@style/PremiumHeading"
                        android:layout_marginTop="6dp"
                        android:text="@string/premium_brand"
                        android:textSize="23sp" />
                    <TextView
                        style="@style/PremiumDescription"
                        android:layout_marginTop="4dp"
                        android:text="@string/premium_hero_subtitle" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="0.48"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:src="@drawable/corgi" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                style="@style/PremiumHeading"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/premium_plans" />

            <LinearLayout
                android:id="@+id/premiumPlanMonthly"
                style="@style/PremiumPlan">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium_month_outline" />

                <LinearLayout style="@style/PremiumPlanText">
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:text="@string/premium_monthly" />
                    <TextView
                        android:id="@+id/premiumPriceMonthly"
                        style="@style/PremiumDescription"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/premiumRadioMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    app:buttonTint="#0873E5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/premiumPlanYearly"
                style="@style/PremiumPlan">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium_year_outline" />

                <LinearLayout style="@style/PremiumPlanText">
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:text="@string/premium_yearly" />
                    <TextView
                        android:id="@+id/premiumPriceYearly"
                        style="@style/PremiumDescription"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/premiumRadioYearly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    app:buttonTint="#0873E5" />
            </LinearLayout>

            <TextView
                style="@style/PremiumDescription"
                android:layout_marginTop="10dp"
                android:text="@string/premium_sandbox_note" />

            <TextView
                android:id="@+id/tvPremiumStatus"
                style="@style/PremiumDescription"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_notification_unread"
                android:padding="14dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumCheckout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="52dp"
                android:maxLines="2"
                android:paddingVertical="8dp"
                android:text="@string/premium_checkout"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:backgroundTint="#0873E5"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumRefresh"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/premium_refresh"
                android:textAllCaps="false"
                android:textColor="#0873E5" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
