<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explore_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnPremiumBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/premium_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#10245E" />

        <TextView
            style="@style/PremiumHeading"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="60dp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/premium_title"
            android:textSize="21sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="150dp"
                android:background="@drawable/bg_premium_card"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_premium_crown" />
                    <TextView
                        style="@style/PremiumHeading"
                        android:layout_marginTop="6dp"
                        android:text="@string/premium_brand"
                        android:textSize="23sp" />
                    <TextView
                        style="@style/PremiumDescription"
                        android:layout_marginTop="4dp"
                        android:text="@string/premium_hero_subtitle" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="116dp"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:src="@drawable/corgi" />
                    <ImageView
                        android:layout_width="33dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|center_horizontal"
                        android:contentDescription="@null"
                        android:rotation="12"
                        android:src="@drawable/ic_premium_crown" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">

                <TextView
                    style="@style/PremiumHeading"
                    android:layout_marginEnd="38dp"
                    android:text="@string/premium_benefits" />
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.25"
                    android:contentDescription="@null"
                    android:rotation="18"
                    android:src="@drawable/ic_paw"
                    app:tint="#168BFF" />
            </FrameLayout>

            <LinearLayout style="@style/PremiumCard">

                <LinearLayout
                    style="@style/PremiumBenefitRow">
                    <ImageView
                        style="@style/PremiumIcon"
                        android:background="@drawable/bg_notification_icon_blue"
                        android:src="@drawable/ic_premium_scan_outline"
                        app:tint="#0877DE" />
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:layout_marginStart="12dp"
                        android:text="@string/premium_recognition" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />

                <LinearLayout
                    style="@style/PremiumBenefitRow">
                    <ImageView
                        style="@style/PremiumIcon"
                        android:background="@drawable/bg_notification_icon_purple"
                        android:src="@drawable/ic_premium_history_outline"
                        app:tint="#783DC4" />
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:layout_marginStart="12dp"
                        android:text="@string/premium_history" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />

                <LinearLayout
                    style="@style/PremiumBenefitRow">
                    <ImageView
                        style="@style/PremiumIcon"
                        android:background="@drawable/bg_settings_icon_teal"
                        android:src="@drawable/ic_paw"
                        app:tint="#087C63" />
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:layout_marginStart="12dp"
                        android:text="@string/premium_suggestions" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/PremiumHeading"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/premium_plans" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/PremiumPlan">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_premium_month_outline" />

                    <LinearLayout
                        style="@style/PremiumPlanText">

                        <TextView
                            style="@style/PremiumRowTitle"
                            android:text="@string/premium_monthly" />

                        <TextView
                            style="@style/PremiumDescription"
                            android:layout_marginTop="3dp"
                            android:text="@string/premium_coming_soon" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/PremiumPlan"
                    android:layout_marginStart="10dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_premium_year_outline" />

                    <LinearLayout
                        style="@style/PremiumPlanText">

                        <TextView
                            style="@style/PremiumRowTitle"
                            android:text="@string/premium_yearly" />

                        <TextView
                            style="@style/PremiumDescription"
                            android:layout_marginTop="3dp"
                            android:text="@string/premium_coming_soon" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/PremiumBenefitRow"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_notification_unread">

                <ImageView
                    style="@style/PremiumIcon"
                    android:src="@drawable/ic_settings_info"
                    app:tint="#0877DE" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/PremiumRowTitle"
                        android:text="@string/premium_unavailable" />
                    <TextView
                        style="@style/PremiumDescription"
                        android:layout_marginTop="3dp"
                        android:text="@string/premium_unavailable_detail" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumBackToProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="@string/premium_back_to_profile"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:backgroundTint="#0873E5"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
