<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/profile_background"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/profileHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cá nhân"
                    android:textColor="#102344"
                    android:textSize="25dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeaderSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản lý tài khoản và cài đặt ứng dụng"
                    android:textColor="#71809B" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="Cài đặt"
                android:scaleType="centerInside"
                android:src="@drawable/ic_setting" />
        </LinearLayout>

        <!-- User Information Card -->
        <LinearLayout
            android:id="@+id/userProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_profile_user"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="112dp"
                android:layout_height="112dp">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/imgUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_avatar"
                    android:clipToOutline="true"
                    android:contentDescription="Ảnh đại diện"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_golden_retriever" />

                <!-- Camera Button -->
                <ImageView
                    android:id="@+id/imgChangeAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_button"
                    android:clickable="true"
                    android:contentDescription="Chọn ảnh đại diện"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_camera_white" />
            </FrameLayout>

            <!-- User Information-->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunitosans_extrabold"
                    android:maxLines="1"
                    android:textColor="#10213D"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="Nguyễn Phi Vũ" />

                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#71809B"
                    android:textSize="14sp"
                    tools:text="nguyenphivu@gmail.com" />

                <!-- Mamber Ship-->
                <TextView
                    android:id="@+id/txtMembership"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_profile_membership"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Thành viên miễn phí"
                    android:textColor="#1585FD"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_right"
                app:tint="#102344" />
        </LinearLayout>


        <FrameLayout
            android:id="@+id/premiumCard"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_premium_card"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Huy hiệu vương miện -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_premium_crown">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_premium_crown"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- Nội dung -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="82dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nâng cấp lên Premium"
                    android:textColor="#142B4A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Mở khóa nhiều tính năng hữu ích hơn"
                    android:textColor="#71819B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPremium"
                    android:layout_width="170dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_premium_button"
                    android:gravity="center"
                    android:text="Xem gói Premium"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Hình Corgi trang trí -->
            <ImageView
                android:id="@+id/imgPremiumCorgi"
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/corgi" />

            <!-- Mũi tên -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:scaleType="fitCenter" />

        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfileStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_profile_stats"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:id="@+id/layoutActivityMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_profile_menu"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/menuFavorite"
                layout="@layout/item_profile_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="16dp"
                android:background="#EEF1F5" />

            <include
                android:id="@+id/menuHistory"
                layout="@layout/item_profile_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="16dp"
                android:background="#EEF1F5" />

            <include
                android:id="@+id/menuViewedArticles"
                layout="@layout/item_profile_menu" />

        </LinearLayout>

        <!-- MENU NHÓM 2: TÀI KHOẢN -->
        <LinearLayout
            android:id="@+id/layoutAccountMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_menu"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/menuPersonalInfo"
                layout="@layout/item_profile_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="16dp"
                android:background="#EEF1F5" />

            <include
                android:id="@+id/menuNotification"
                layout="@layout/item_profile_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="16dp"
                android:background="#EEF1F5" />

            <include
                android:id="@+id/menuSettings"
                layout="@layout/item_profile_menu" />

        </LinearLayout>

        <!-- MENU NHÓM 3: ĐĂNG XUẤT -->
        <LinearLayout
            android:id="@+id/layoutLogoutMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_profile_menu"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/menuLogout"
                layout="@layout/item_profile_menu" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>