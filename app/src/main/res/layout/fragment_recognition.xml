<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/identify_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- Thanh tiêu đề -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/nunitosans_extrabold"
                android:text="Đang nhận diện"
                android:textColor="#102344"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Ảnh tròn + vòng tiến trình -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="214dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false">

            <View
                android:layout_width="214dp"
                android:layout_height="214dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_halo_outer" />

            <View
                android:layout_width="194dp"
                android:layout_height="194dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_halo_inner" />

            <!-- Chấm trang trí -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_dot"
                android:translationX="-110dp"
                android:translationY="-72dp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_dot"
                android:translationX="90dp"
                android:translationY="-92dp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_dot"
                android:translationX="-130dp"
                android:translationY="-6dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_dot"
                android:translationX="90dp"
                android:translationY="94dp" />

            <!-- Viền trắng quanh ảnh -->
            <View
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_photo_border" />

            <!-- Ảnh chó người dùng chọn -->
            <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="146dp"
                android:layout_height="152dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_identify_photo_clip"
                android:clipToOutline="true"
                android:contentDescription="Ảnh chó nhận diện"
                android:scaleType="centerCrop" />

            <!-- Vòng tiến trình -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressRing"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="0"
                app:indicatorColor="#69B1FE"
                app:indicatorSize="178dp"
                app:trackColor="#E9F2FD"
                app:trackCornerRadius="4dp"
                app:trackThickness="7dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunitosans_extrabold"
            android:gravity="center"
            android:text="0%"
            android:textColor="@color/identify_blue"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunitosans_extrabold"
            android:gravity="center"
            android:text="Đang phân tích hình ảnh..."
            android:textColor="#0B1B3F"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="AI đang nhận diện giống chó của bạn\nvui lòng chờ trong giây lát"
            android:textColor="#7B8195"
            android:textSize="14sp" />

        <!-- 4 bước -->
        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_identify_card"
            android:orientation="vertical"
            android:padding="6dp" />

        <!-- Khoảng trống co giãn: đẩy cụm corgi xuống sát đáy màn hình -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- Corgi (trái, dưới) + bong bóng chữ (phải, trên) đặt cạnh nhau -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/imgCorgi"
                android:layout_width="wrap_content"
                android:layout_height="160dp"
                android:layout_gravity="bottom|start"
                android:adjustViewBounds="true"
                android:contentDescription="Chú chó corgi cầm kính lúp"
                android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_identify_bubble"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="180dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:textColor="#1E7CF5"
                    android:textSize="14sp" />

                <!-- Đuôi bong bóng -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="-1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_identify_bubble_tail" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>