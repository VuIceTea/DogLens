<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F8FF">

    <ImageView android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="top|end" android:layout_marginTop="58dp" android:layout_marginEnd="-14dp" android:alpha="0.16" android:src="@drawable/deco_paw" />
    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginBottom="18dp" android:alpha="0.14" android:rotation="-18" android:src="@drawable/deco_paw" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="22dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_light" android:contentDescription="Quay lại" android:padding="11dp" android:src="@drawable/ic_arrow_back" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cài đặt" android:textColor="#071B4D" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tùy chỉnh trải nghiệm của bạn" android:textColor="#71809B" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsSectionTitle" android:text="Chung" />
            <LinearLayout style="@style/SettingsCard">
                <include android:id="@+id/rowLanguage" layout="@layout/item_setting_row" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowTheme" layout="@layout/item_setting_toggle" />
            </LinearLayout>

            <TextView style="@style/SettingsSectionTitle" android:text="Thông báo" />
            <LinearLayout style="@style/SettingsCard">
                <include android:id="@+id/rowRecognitionNotification" layout="@layout/item_setting_toggle" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowArticleNotification" layout="@layout/item_setting_toggle" />
            </LinearLayout>

            <TextView style="@style/SettingsSectionTitle" android:text="Quyền riêng tư &amp; tài khoản" />
            <LinearLayout style="@style/SettingsCard">
                <include android:id="@+id/rowPermissions" layout="@layout/item_setting_row" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowPassword" layout="@layout/item_setting_row" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowDeleteAccount" layout="@layout/item_setting_row" />
            </LinearLayout>

            <TextView style="@style/SettingsSectionTitle" android:text="Hỗ trợ" />
            <LinearLayout style="@style/SettingsCard">
                <include android:id="@+id/rowTerms" layout="@layout/item_setting_row" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowPrivacy" layout="@layout/item_setting_row" />
                <View style="@style/SettingsDivider" />
                <include android:id="@+id/rowVersion" layout="@layout/item_setting_row" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="DogLens • Nhận diện giống chó bằng AI" android:textColor="#8A97AC" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
