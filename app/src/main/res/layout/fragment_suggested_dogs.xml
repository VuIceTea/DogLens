<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:paddingHorizontal="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="Quay lại"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/suggestedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunitosans_extrabold"
                android:text="Gợi ý cho bạn"
                android:textColor="#10245E"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/suggestedSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Những giống chó có đặc điểm tương tự"
                android:textColor="#7885A6"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/suggestedSearch"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_suggested_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_step_search"
            app:tint="#667895" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Tìm giống chó..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#10245E"
            android:textColorHint="#8B97AF"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/suggestedFilters"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="18dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/filterAll" style="@style/Widget.DogLens.SuggestedFilter" android:text="Tất cả" />
            <TextView android:id="@+id/filterPopular" style="@style/Widget.DogLens.SuggestedFilter" android:text="Phổ biến" />
            <TextView android:id="@+id/filterSize" style="@style/Widget.DogLens.SuggestedFilter" android:text="Kích thước" />
            <TextView android:id="@+id/filterTrait" style="@style/Widget.DogLens.SuggestedFilter" android:text="Tính cách" />
            <TextView android:id="@+id/filterOrigin" style="@style/Widget.DogLens.SuggestedFilter" android:text="Nguồn gốc" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:indeterminateTint="#168FF2" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="Không tìm thấy giống chó phù hợp"
        android:textColor="#7885A6"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestedDogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp" />
</LinearLayout>
