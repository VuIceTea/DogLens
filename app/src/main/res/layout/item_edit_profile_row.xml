<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/bg_profile_row"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- ICON BÊN TRÁI -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_profile_icon_circle">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- LABEL + GIÁ TRỊ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- CHỮ PHÍA TRÊN -->
        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7885B3"
            android:textSize="13sp" />

        <!-- GIÁ TRỊ PHÍA DƯỚI -->
        <TextView
            android:id="@+id/rowValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#10245E"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- ICON CHỈNH SỬA -->
    <LinearLayout
        android:id="@+id/rowActionContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rowActionIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_edit"
            app:tint="#7885B3" />
    </LinearLayout>
</LinearLayout>
