<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="premium_title">Nâng cấp Premium</string>
    <string name="premium_brand">DogLens Premium</string>
    <string name="premium_hero_subtitle">Khám phá quyền lợi dự kiến</string>
    <string name="premium_benefits">Quyền lợi dự kiến</string>
    <string name="premium_recognition">Thêm lượt nhận diện</string>
    <string name="premium_history">Lịch sử mở rộng</string>
    <string name="premium_suggestions">Gợi ý giống chó</string>
    <string name="premium_plans">Các gói dự kiến</string>
    <string name="premium_monthly">Gói tháng</string>
    <string name="premium_yearly">Gói năm</string>
    <string name="premium_coming_soon">Sắp ra mắt</string>
    <string name="premium_unavailable">Chưa mở đăng ký</string>
    <string name="premium_unavailable_detail">Giá và quyền lợi sẽ được công bố khi Premium ra mắt.</string>
    <string name="premium_back_to_profile">Quay lại Cá nhân</string>
    <string name="premium_back">Quay lại</string>

    <style name="PremiumHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#071B4D</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/nunitosans_extrabold</item>
    </style>

    <style name="PremiumRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#071B4D</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunitosans_bold</item>
    </style>

    <style name="PremiumDescription">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#52627C</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PremiumCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_profile_menu</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PremiumBenefitRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">9dp</item>
    </style>

    <style name="PremiumIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="PremiumPlan">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">74dp</item>
        <item name="android:background">@drawable/bg_profile_menu</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="PremiumPlanText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
