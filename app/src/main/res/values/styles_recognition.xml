<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.DogLens.Rounded20" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.DogLens.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/nunitosans_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/identify_blue</item>
        <item name="cornerRadius">27dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@null</item>
    </style>

    <style name="Widget.DogLens.Button.Secondary" parent="Widget.DogLens.Button.Primary">
        <item name="android:textColor">#0B1B3F</item>
        <item name="backgroundTint">#EEF2F8</item>
    </style>

    <style name="Widget.DogLens.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/nunitosans_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/identify_blue</item>
        <item name="strokeColor">@color/identify_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">25dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/identify_blue</item>
    </style>

    <style name="TextAppearance.DogLens.CardTitle" parent="">
        <item name="android:fontFamily">@font/nunitosans_extrabold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#0B1B3F</item>
    </style>
</resources>